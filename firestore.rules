rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 1. อนุญาตให้เข้าถึงข้อมูล POS หลัก
    match /pos/data {
      allow read, write: if request.auth != null;
    }
    
    // 2. อนุญาตให้เข้าถึงระบบเช็คการส่งรายงาน (ตั้งค่าล็อก) ที่เพิ่งเพิ่มเข้าไปใหม่
    match /settings/autoReport {
      allow read, write: if request.auth != null;
    }
    
  }
}